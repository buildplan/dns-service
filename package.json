{
  "name": "dns-service",
  "version": "1.1.0",
  "description": "WiredAlter DNS Lookup Service",
  "main": "server.js",
  "scripts": {
    "build": "node scripts/build-assets.mjs",
    "prestart": "node scripts/build-assets.mjs --if-available",
    "start": "node server.js",
    "dev": "nodemon --watch server.js --watch src --watch views/index.html --watch views/terms.html --ext js,mjs,css,html --exec \"node scripts/build-assets.mjs --if-available && node server.js\""
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "lru-cache": "^11.5.3"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "maplibre-gl": "^6.18.0",
    "nodemon": "^3.1.14",
    "tailwindcss": "^4.3.5"
  },
  "engines": {
    "node": ">=26.13.1"
  }
}
